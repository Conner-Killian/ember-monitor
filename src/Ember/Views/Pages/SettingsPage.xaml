<UserControl x:Class="Ember.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="2,24,0,10" />
        </Style>
        <Style x:Key="ThresholdBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="76" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel MaxWidth="980">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />

            <!-- ===== General ===== -->
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="2,18,0,10" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Temperature unit" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Used in the dashboard, overlay, tray and alerts." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="UnitC" Style="{StaticResource SegmentButton}" GroupName="Unit" Content="Celsius  °C" Click="Changed" />
                            <RadioButton x:Name="UnitF" Style="{StaticResource SegmentButton}" GroupName="Unit" Content="Fahrenheit  °F" Click="Changed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Update interval" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="How often sensors are read. Slower intervals use slightly less CPU." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="IntervalCombo" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Changed">
                        <ComboBoxItem Content="0.5 seconds" Tag="500" />
                        <ComboBoxItem Content="1 second" Tag="1000" />
                        <ComboBoxItem Content="2 seconds" Tag="2000" />
                        <ComboBoxItem Content="5 seconds" Tag="5000" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Primary graphics card" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="The GPU shown on the overlay and dashboard. Auto picks your dedicated card." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="GpuCombo" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="240" SelectionChanged="Changed" />
                </Grid>
            </Border>

            <!-- ===== Startup ===== -->
            <TextBlock Text="Startup &amp; tray" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Starts quietly in the tray with the overlay ready when you sign in. Uses a scheduled task, so there's no UAC prompt at boot." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Startup_Click" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Keep running in the tray when closed" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Closing the window keeps the overlay and alerts running. Use Exit in the tray menu to quit." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="TrayToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Changed" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Show CPU temperature in tray icon" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Replaces the Ember icon with a live number." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="TrayTempToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Changed" />
                </Grid>
            </Border>

            <!-- ===== Alerts ===== -->
            <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Colour-code temperatures" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Readings turn amber at the warning threshold and red at critical." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="ColorToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Changed" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,330,0">
                        <TextBlock Text="Notify me when something stays hot" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Shows a Windows notification when a part stays above its critical threshold. Repeats at most every 5 minutes." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="for" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="SustainCombo" MinWidth="120" Margin="0,0,16,0" SelectionChanged="Changed">
                            <ComboBoxItem Content="5 seconds" Tag="5" />
                            <ComboBoxItem Content="10 seconds" Tag="10" />
                            <ComboBoxItem Content="30 seconds" Tag="30" />
                            <ComboBoxItem Content="1 minute" Tag="60" />
                        </ComboBox>
                        <CheckBox x:Name="NotifyToggle" Style="{StaticResource ToggleSwitch}" Click="Changed" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,4">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Thresholds" Style="{StaticResource RowTitle}" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="Restore defaults" FontSize="12" Click="ResetThresholds_Click" />
                    </Grid>
                    <Grid x:Name="ThresholdGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource Overline}" Foreground="{DynamicResource WarmBrush}" x:Name="WarnHeader" Text="WARNING" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource Overline}" Foreground="{DynamicResource HotBrush}" x:Name="CritHeader" Text="CRITICAL" />

                        <TextBlock Grid.Row="1" Text="Processor (CPU)" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CpuWarn" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="CpuCrit" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />

                        <TextBlock Grid.Row="2" Text="Graphics (GPU)" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="GpuWarn" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="GpuCrit" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />

                        <TextBlock Grid.Row="3" Text="Memory (RAM)" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="RamWarn" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                        <TextBox Grid.Row="3" Grid.Column="2" x:Name="RamCrit" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />

                        <TextBlock Grid.Row="4" Text="Solid-state drives (SSD / NVMe)" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SsdWarn" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="SsdCrit" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />

                        <TextBlock Grid.Row="5" Text="Hard drives (HDD)" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="HddWarn" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                        <TextBox Grid.Row="5" Grid.Column="2" x:Name="HddCrit" Style="{StaticResource ThresholdBox}" LostFocus="Threshold_LostFocus" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Appearance ===== -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Accent colour" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Used for gauges, graphs and highlights." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ItemsControl x:Name="Swatches" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Swatch_Click" Tag="{Binding}" Margin="3,0" Cursor="Hand" ToolTip="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Width="26" Height="26">
                                                    <Ellipse x:Name="ring" Stroke="White" StrokeThickness="2" Opacity="0" />
                                                    <Ellipse Margin="4" Fill="{Binding}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Opacity" Value="0.6" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="AccentHex" Width="90" Margin="12,0,0,0" MaxLength="9" LostFocus="AccentHex_LostFocus" KeyDown="AccentHex_KeyDown" />
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Window material" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Mica and Acrylic need Windows 11 22H2 or later. Older systems fall back to Solid." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BdMica" Style="{StaticResource SegmentButton}" GroupName="Backdrop" Content="Mica" Click="Changed" />
                            <RadioButton x:Name="BdAcrylic" Style="{StaticResource SegmentButton}" GroupName="Backdrop" Content="Acrylic" Click="Changed" />
                            <RadioButton x:Name="BdSolid" Style="{StaticResource SegmentButton}" GroupName="Backdrop" Content="Solid" Click="Changed" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}" x:Name="TintRow">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tint strength" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="How much of the desktop shows through the window." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TintText" Style="{StaticResource Caption}" Width="40" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Slider x:Name="TintSlider" Width="220" Minimum="0" Maximum="1" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Interface size" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Scale this window's text and controls." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UiScaleText" Style="{StaticResource Caption}" Width="40" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Slider x:Name="UiScaleSlider" Width="220" Minimum="0.8" Maximum="1.3" ValueChanged="Slider_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Temperature log ===== -->
            <TextBlock Text="Temperature log" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Record a temperature log" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Keeps CPU, GPU, memory and drive temperatures for the Log tab. One entry a minute, saved every 10 minutes into a file of fixed size, so it never grows and barely writes to your drive." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="LogToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Changed" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                        <TextBlock Text="Keep the log for" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="LogSizeText" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <ComboBox x:Name="LogDaysCombo" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="140" SelectionChanged="Changed">
                        <ComboBoxItem Content="1 day" Tag="1" />
                        <ComboBoxItem Content="3 days" Tag="3" />
                        <ComboBoxItem Content="7 days" Tag="7" />
                        <ComboBoxItem Content="14 days" Tag="14" />
                        <ComboBoxItem Content="30 days" Tag="30" />
                        <ComboBoxItem Content="90 days" Tag="90" />
                        <ComboBoxItem Content="1 year" Tag="365" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Delete the log" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="LogFileText" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <Button x:Name="DeleteLogButton" Content="Delete log" HorizontalAlignment="Right" VerticalAlignment="Center" Click="DeleteLog_Click" />
                </Grid>
            </Border>

            <!-- ===== Updates ===== -->
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="UpdateTitle" Text="Ember" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="UpdateDesc" Style="{StaticResource RowDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ReleaseNotesButton" Style="{StaticResource GhostButton}" Content="What's new" Margin="0,0,8,0" Click="ReleaseNotes_Click" />
                        <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click" />
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Content="Update" Margin="8,0,0,0" Click="InstallUpdate_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,140,0">
                        <TextBlock Text="Check for updates automatically" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Checks GitHub when Ember starts and every 6 hours. Updates only install when you choose, and only if they're signed with Ember's release key." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="Changed" />
                </Grid>
            </Border>

            <!-- ===== Driver / about ===== -->
            <TextBlock Text="Sensors driver" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,200,0">
                        <TextBlock x:Name="DriverTitle" Text="PawnIO" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="DriverDesc" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <Button x:Name="DriverButton" Style="{StaticResource AccentButton}" Content="Install driver" HorizontalAlignment="Right" VerticalAlignment="Center" Click="InstallDriver_Click" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/ember.png" Width="36" Height="36" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="Ember" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="Sensor data provided by LibreHardwareMonitor (MPL 2.0)." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Open settings folder" Click="OpenFolder_Click" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                        <TextBlock Text="Changelog and source code" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="See what changed in each version, report a problem, or browse the source on GitHub." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Changelog" Margin="0,0,8,0" Click="Changelog_Click" />
                        <Button Content="GitHub" Click="GitHub_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
