<UserControl x:Class="Ember.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ember.Controls">
    <UserControl.Resources>
        <!-- Stat tile used inside hero cards -->
        <DataTemplate x:Key="StatTile">
            <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="9" Padding="12,9" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KeyValueRow">
            <Grid Margin="0,5">
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SubTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                <TextBlock Text="{Binding Value}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
            </Grid>
        </DataTemplate>

        <!-- Hero card for CPU / GPU -->
        <DataTemplate x:Key="HeroCard">
            <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- header -->
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <!-- gauge + stats -->
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="150" Height="150">
                            <c:RingGauge Thickness="11" Value="{Binding Fraction}" Color="{Binding Color}" Sweep="270" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Temp}" Foreground="{Binding Brush}" FontSize="44" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock Text="{Binding Unit}" FontSize="16" Foreground="{DynamicResource SubTextBrush}" Margin="2,8,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SeverityText}" HorizontalAlignment="Center" FontSize="12" Foreground="{Binding Brush}" Opacity="0.85" Margin="0,-4,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="22,4,0,0" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTile}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="2,2,0,0" Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <!-- history -->
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="LAST 5 MINUTES" Style="{StaticResource Overline}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="min " Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Min}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="   max " Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Max}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Height="70" Values="{Binding History}" Color="{Binding Color}" Capacity="300" MinSpan="8" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>
            <!-- ===== Header ===== -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource H1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding HeadlineBrush}" VerticalAlignment="Center" Margin="1,0,9,0" />
                        <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HeadlineSub}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetMinMax_Click" ToolTip="Reset session min / max">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Reset min/max" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== Driver banner ===== -->
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16" BorderBrush="#66FFB03B" Background="#26FFB03B"
                    Visibility="{Binding DriverMissing, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarmBrush}" FontSize="20" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CPU and memory temperatures need the PawnIO driver" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Windows only exposes these sensors through a signed kernel driver. GPU and drive temperatures work without it." />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Install driver" Margin="14,0,0,0" Click="InstallDriver_Click" />
                </Grid>
            </Border>

            <!-- ===== Hero row ===== -->
            <UniformGrid Columns="2" Margin="-8,0">
                <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource HeroCard}" Margin="8,0" Focusable="False" />
                <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource HeroCard}" Margin="8,0" Focusable="False" />
            </UniformGrid>

            <!-- ===== Memory + Storage ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Memory -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource Overline}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RamSummary}" Foreground="{Binding RamBrush}" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="hottest DIMM" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,7"
                                       Visibility="{Binding HasRamTemps, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" x:Name="NoRamText"
                                   Text="No DIMM temperature sensors found. DDR5 modules usually have them; most DDR4 modules don't." />
                        <ItemsControl ItemsSource="{Binding RamSticks}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,50,0" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Brush}">
                                                <Run Text="{Binding Temp, Mode=OneWay}" /><Run Text="{Binding Unit, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                        <c:FractionBar Height="4" Margin="0,5,0,0" Value="{Binding Fraction}" Color="{Binding Color}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12,0,8" />
                        <ItemsControl ItemsSource="{Binding MemoryStats}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Storage -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource Overline}" />
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SubtleFillBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Media}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Used}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <c:Sparkline Grid.Column="2" Height="32" Values="{Binding History}" Color="{Binding Color}" Capacity="300" MinSpan="6" Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Temp}" Foreground="{Binding Brush}" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" Margin="2,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Cooling + board ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FANS" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Fans}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" x:Name="NoFansText"
                                   Text="No fan speed sensors reported. Motherboard fan readings need the PawnIO driver, and some boards don't expose them." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MOTHERBOARD" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding BoardTemps}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" x:Name="NoBoardText"
                                   Text="No motherboard temperature sensors reported." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
