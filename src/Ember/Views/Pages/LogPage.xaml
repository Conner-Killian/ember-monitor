<UserControl x:Class="Ember.Views.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ember.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <!-- Where each card's readings sit: beside the name (default), or under it on a narrow page. -->
        <sys:Int32 x:Key="ChipsRow">0</sys:Int32>
        <sys:Int32 x:Key="ChipsColumn">1</sys:Int32>
        <sys:Int32 x:Key="ChipsColumnSpan">1</sys:Int32>
        <Thickness x:Key="ChipsMargin">0</Thickness>

        <!-- Small headline number inside a component card -->
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}" />
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <DataTemplate x:Key="LogCard">
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,0,24,0">
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Overline}" />
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Beside the name when there's room, under it on a narrow page (resources set by LogPage.ApplyWidth). -->
                    <StackPanel Orientation="Horizontal" Grid.Row="{DynamicResource ChipsRow}" Grid.Column="{DynamicResource ChipsColumn}"
                                Grid.ColumnSpan="{DynamicResource ChipsColumnSpan}" Margin="{DynamicResource ChipsMargin}" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Average" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding Average}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Peak" Style="{StaticResource StatLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Peak}" Style="{StaticResource StatValue}" />
                                    <TextBlock Text="{Binding PeakWhen}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="9" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Lowest" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding Low}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="9" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Above warning" Style="{StaticResource StatLabel}" />
                                <TextBlock Text="{Binding AboveWarning}" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <c:LogChart Grid.Row="2" Grid.ColumnSpan="2" Height="170" Margin="0,16,0,0"
                                Bins="{Binding Bins}" FromMinute="{Binding FromMinute}" ToMinute="{Binding ToMinute}"
                                Warn="{Binding Warn}" Critical="{Binding Critical}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel MaxWidth="1180">
            <!-- ===== Header ===== -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Log" Style="{StaticResource H1}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel x:Name="RangeHost" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                    <TextBlock Text="Show the last" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="RangeCombo" MinWidth="130" SelectionChanged="Range_Changed" />
                </StackPanel>
            </Grid>

            <!-- ===== Logging off ===== -->
            <Border x:Name="OffCard" Style="{StaticResource Card}" Padding="26,24" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top" Margin="0,0,18,0">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Temperature logging is off" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="OffText" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button Content="Settings" Margin="0,0,8,0" Click="Settings_Click" />
                        <Button Style="{StaticResource AccentButton}" Content="Turn on logging" Click="TurnOn_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Waiting for the first minute ===== -->
            <Border x:Name="EmptyCard" Style="{StaticResource Card}" Padding="26,24" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Collecting temperatures" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Ember records one entry a minute. The first one appears here within a minute, and charts fill in as the log grows." />
                </StackPanel>
            </Border>

            <!-- ===== Components ===== -->
            <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource LogCard}" Focusable="False" />

            <!-- ===== Daily summary ===== -->
            <Border x:Name="DailyCard" Style="{StaticResource Card}" Padding="22,18" Margin="0,4,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="DAILY SUMMARY" Style="{StaticResource Overline}" />
                    <TextBlock Text="Average · peak for each day. Amber marks days that reached the warning threshold." Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <Grid x:Name="DailyGrid" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
