<UserControl x:Class="Ember.Views.OverlayContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ember.Controls"
             xmlns:local="clr-namespace:Ember.Views"
             TextElement.Foreground="#F2F3F7"
             Typography.NumeralAlignment="Tabular"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="OvLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9EA1AE" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
        </Style>
        <Style x:Key="OvExtra" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#8C8F9C" />
            <Setter Property="Visibility" Value="{Binding HasExtra, Converter={StaticResource BoolToVis}}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- Cheap "shadow": two soft outlines instead of a blur effect. Blur effects force the
             layered overlay window to re-render in software every update, which costs real CPU. -->
        <Border x:Name="Halo2" CornerRadius="17" Margin="-3,-2,-3,-4" Background="#14000000" IsHitTestVisible="False" />
        <Border x:Name="Halo1" CornerRadius="15.5" Margin="-1.5,-1,-1.5,-2" Background="#22000000" IsHitTestVisible="False" />
        <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#26FFFFFF" Background="#D0101116"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="#A3A6B4" Margin="16,9"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

                <!-- ================= PILL ================= -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="14,7,14,7" Focusable="False" HorizontalAlignment="Center"
                              Visibility="{Binding IsPill, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="1" Height="16" Fill="#24FFFFFF" Margin="12,0,12,0" VerticalAlignment="Center"
                                           Visibility="{Binding RelativeSource={RelativeSource PreviousData}, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource OvLabel}" Margin="0,1,7,0" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="17" FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#8C8F9C" VerticalAlignment="Top" Margin="1,2,0,0" />
                                </StackPanel>
                                <!-- Hidden placeholder reserves the width of "88% · 888W" so the pill doesn't change size -->
                                <Grid VerticalAlignment="Center" Margin="7,1,0,0" Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExtraReserve}" Style="{StaticResource OvExtra}" Visibility="Hidden" />
                                    <TextBlock Text="{Binding Extra}" Style="{StaticResource OvExtra}" HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================= CARD ================= -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="14,8,14,10" Focusable="False" MinWidth="170"
                              Visibility="{Binding IsCard, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="44" />
                                    <ColumnDefinition Width="*" MinWidth="48" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="#A3A6B4" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExtraReserve}" Style="{StaticResource OvExtra}" Visibility="Hidden" />
                                    <TextBlock Text="{Binding Extra}" Style="{StaticResource OvExtra}" HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                    <TextBlock Text="{Binding Unit}" FontSize="10.5" Foreground="#8C8F9C" Margin="2,2,0,0" />
                                </StackPanel>
                                <c:FractionBar Animate="False" Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,4,0,0"
                                               Value="{Binding Fraction}" Color="{Binding GaugeColor}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ================= RINGS ================= -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="10,10,10,8" Focusable="False" HorizontalAlignment="Center"
                              Visibility="{Binding IsRings, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,0" MinWidth="60">
                                <Grid Width="54" Height="54">
                                    <c:RingGauge Animate="False" Thickness="5" Value="{Binding Fraction}" Color="{Binding GaugeColor}" Sweep="270" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                                        <TextBlock Text="{Binding Unit}" FontSize="9.5" Foreground="#8C8F9C" Margin="1,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A3A6B4"
                                           HorizontalAlignment="Center" Margin="0,-6,0,0" TextTrimming="CharacterEllipsis" />
                                <Grid HorizontalAlignment="Center" Margin="0,1,0,0" Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExtraReserve}" Style="{StaticResource OvExtra}" Visibility="Hidden" FontSize="10" />
                                    <TextBlock Text="{Binding Extra}" Style="{StaticResource OvExtra}" HorizontalAlignment="Center" FontSize="10" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Unlocked state: drawn on top of the shell without changing its size, so the overlay
             doesn't jump when you lock it again. -->
        <Grid x:Name="UnlockLayer" Visibility="{Binding Unlocked, Converter={StaticResource BoolToVis}}">
            <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                       StrokeDashArray="4 3" IsHitTestVisible="False" />
            <Button x:Name="LockButton" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-8,-8,0" Cursor="Hand" Click="LockButton_Click" ToolTip="Drag to move, then click to lock in place">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{DynamicResource AccentBrush}" Stroke="#40000000" StrokeThickness="1" />
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10.5"
                                       Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.85" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
