<Window x:Class="Ember.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ember" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/ember.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowTintBrush}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WinScale" />
                <TranslateTransform x:Name="WinShift" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{DynamicResource UiScale}" ScaleY="{DynamicResource UiScale}" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar ===== -->
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" Grid.ColumnSpan="2">
                <Image Source="/Assets/ember.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Ember" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AdminBadge" Text="Temperature monitor" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Min_Click" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="Max_Click" ToolTip="Maximize">
                    <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </StackPanel>

            <!-- ===== Navigation ===== -->
            <DockPanel Grid.Row="1" Margin="10,8,10,14">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Overlay" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="OverlayQuickToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                      Click="OverlayQuickToggle_Click" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Dashboard" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSensors" Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="All sensors" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavOverlay" Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Overlay" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Page host ===== -->
            <Border Grid.Row="1" Grid.Column="1" CornerRadius="12,0,0,0" Background="#0AFFFFFF"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,1,0,0">
                <ContentControl x:Name="PageHost" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
    </Border>
</Window>
