<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Ember.Controls"
             xmlns:vm="using:Ember.ViewModels"
             x:Class="Ember.Views.Pages.SensorsPage">
    <Grid Margin="28,22,28,0" RowDefinitions="Auto,*">
        <Grid Margin="0,0,0,16" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="All sensors" Classes="h1" />
                <TextBlock Text="Every reading your hardware exposes, with session minimum and maximum." Classes="caption" Margin="0,6,0,0" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="18">
                <CheckBox Content="Temperatures only" IsChecked="{Binding TempsOnly}" FontSize="13" />
                <TextBox Width="240" Watermark="Filter sensors" Text="{Binding Filter}">
                    <TextBox.InnerLeftContent>
                        <c:Icon Kind="search" Width="14" Height="14" Margin="10,0,2,0" Foreground="{DynamicResource MutedBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
        </Grid>

        <!-- Flat, virtualized list: only rows on screen get visuals (hundreds of sensors otherwise). -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="0,0,0,18" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:SensorGroupVM">
                    <Border Classes="groupCard" Classes.expanded="{Binding IsExpanded}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Button Classes="groupHeader" Click="Header_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                                    <c:Icon Kind="{Binding IconKind}" Width="18" Height="18" Foreground="{DynamicResource AccentLightBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Kind}" Classes="caption" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <c:Icon Grid.Column="3" Classes="chev" Classes.up="{Binding IsExpanded}" Kind="chevron" Width="14" Height="14"
                                        Foreground="{DynamicResource SubTextBrush}" RenderTransformOrigin="50%,50%" />
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="vm:SensorColumnsVM">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,1,0" Padding="18,2,18,6">
                        <Grid ColumnDefinitions="*,110,110,110,110">
                            <TextBlock Text="SENSOR" Classes="overline" />
                            <TextBlock Grid.Column="1" Text="TYPE" Classes="overline" />
                            <TextBlock Grid.Column="2" Text="CURRENT" Classes="overline" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="MIN" Classes="overline" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="MAX" Classes="overline" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="vm:SensorRowVM">
                    <Border Classes="rowCard" Classes.last="{Binding IsLast}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                            <Grid ColumnDefinitions="*,110,110,110,110">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding Brush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Min}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding Max}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </Grid>

    <UserControl.Styles>
        <!-- Each list item draws its slice of the device card. -->
        <Style Selector="Border.groupCard">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.groupCard.expanded">
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="12,12,0,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Border.rowCard">
            <Setter Property="BorderThickness" Value="1,0,1,0" />
            <Setter Property="Padding" Value="18,0,18,0" />
        </Style>
        <Style Selector="Border.rowCard.last">
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,12,12" />
            <Setter Property="Padding" Value="18,0,18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Button.groupHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.groupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
        </Style>
        <Style Selector="c|Icon.chev.up">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
    </UserControl.Styles>
</UserControl>
