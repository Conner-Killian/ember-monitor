<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Ember.Controls"
             x:Class="Ember.Views.OverlayContent"
             Foreground="#F2F3F7"
             UseLayoutRounding="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.ovLabel">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9EA1AE" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ovExtra">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#8C8F9C" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
    </UserControl.Styles>

    <LayoutTransformControl x:Name="ScaleHost">
        <Grid x:Name="Root">
            <!-- Cheap "shadow": two soft outlines instead of a blur effect (keeps redraw cost low). -->
            <Border x:Name="Halo2" CornerRadius="17" Margin="-3,-2,-3,-4" Background="#14000000" IsHitTestVisible="False" />
            <Border x:Name="Halo1" CornerRadius="15.5" Margin="-1.5,-1,-1.5,-2" Background="#22000000" IsHitTestVisible="False" />
            <Border x:Name="Shell" CornerRadius="14" BorderThickness="1" BorderBrush="#26FFFFFF" Background="#D0101116">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="#A3A6B4" Margin="16,9" IsVisible="{Binding HasStatus}" />

                    <!-- ================= PILL ================= -->
                    <ItemsControl ItemsSource="{Binding Items}" Margin="14,7,14,7" HorizontalAlignment="Center" IsVisible="{Binding IsPill}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="1" Height="16" Fill="#24FFFFFF" Margin="12,0,12,0" VerticalAlignment="Center" IsVisible="{Binding !IsFirst}" />
                                    <TextBlock Text="{Binding Label}" Classes="ovLabel" Margin="0,1,7,0"
                                               IsVisible="{Binding $parent[UserControl].DataContext.ShowLabels, FallbackValue=True}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Classes="num" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#8C8F9C" VerticalAlignment="Top" Margin="1,2,0,0" />
                                    </StackPanel>
                                    <!-- Hidden placeholder reserves the width of "88% · 888W" so the pill doesn't change size -->
                                    <Grid VerticalAlignment="Center" Margin="7,1,0,0" IsVisible="{Binding HasExtra}">
                                        <TextBlock Classes="ovExtra num" Text="{Binding ExtraReserve}" Opacity="0" />
                                        <TextBlock Classes="ovExtra num" Text="{Binding Extra}" HorizontalAlignment="Left" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ================= CARD ================= -->
                    <ItemsControl ItemsSource="{Binding Items}" Margin="14,8,14,10" MinWidth="170" IsVisible="{Binding IsCard}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="{Binding Label}" MinWidth="34" FontSize="11" FontWeight="SemiBold" Foreground="#A3A6B4" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" IsVisible="{Binding HasExtra}">
                                        <TextBlock Classes="ovExtra num" Text="{Binding ExtraReserve}" Opacity="0" />
                                        <TextBlock Classes="ovExtra num" Text="{Binding Extra}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Classes="num" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Unit}" FontSize="10.5" Foreground="#8C8F9C" Margin="2,2,0,0" />
                                    </StackPanel>
                                    <c:FractionBar Animate="False" Grid.Row="1" Grid.ColumnSpan="3" Height="4" Margin="0,4,0,0"
                                                   Value="{Binding Fraction}" Color="{Binding GaugeColor}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ================= RINGS ================= -->
                    <ItemsControl ItemsSource="{Binding Items}" Margin="10,10,10,8" HorizontalAlignment="Center" IsVisible="{Binding IsRings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0" MinWidth="60">
                                    <Grid Width="54" Height="54">
                                        <c:RingGauge Animate="False" Thickness="5" Value="{Binding Fraction}" Color="{Binding GaugeColor}" Sweep="270" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Classes="num" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Unit}" FontSize="9.5" Foreground="#8C8F9C" Margin="1,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="#A3A6B4"
                                               HorizontalAlignment="Center" Margin="0,-6,0,0" TextTrimming="CharacterEllipsis" />
                                    <Grid HorizontalAlignment="Center" Margin="0,1,0,0" IsVisible="{Binding HasExtra}">
                                        <TextBlock Classes="ovExtra num" Text="{Binding ExtraReserve}" Opacity="0" FontSize="10" />
                                        <TextBlock Classes="ovExtra num" Text="{Binding Extra}" HorizontalAlignment="Center" FontSize="10" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unlocked: dashed outline + lock button drawn on top, without changing the size. -->
            <Grid x:Name="UnlockLayer" IsVisible="{Binding Unlocked}">
                <Border CornerRadius="14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" IsHitTestVisible="False" />
                <Button x:Name="LockButton" Width="22" Height="22" Padding="0" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-8,-8,0" Classes="accent" ToolTip.Tip="Drag to move, then click to lock in place" Click="LockButton_Click">
                    <c:Icon Kind="lock" Width="12" Height="12" Foreground="{DynamicResource AccentForegroundBrush}" />
                </Button>
            </Grid>
        </Grid>
    </LayoutTransformControl>
</UserControl>
